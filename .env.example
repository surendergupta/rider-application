NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets. Never prefix with NEXT_PUBLIC_.
# Needed for account deletion and the e2e test (creates/deletes test users).
SUPABASE_SECRET_KEY=
# Only for `npm run test:db` and running migrations from the command line.
DATABASE_URL=

# Optional: OSRM-compatible routing service. Unset = manual distance entry only.
# The public OSRM demo server is not for production use; use a service whose terms allow your usage.
ROUTING_BASE_URL=
